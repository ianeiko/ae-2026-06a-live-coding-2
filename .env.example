# Copy to .env and fill in the two keys you were given / signed up for.
# .env is gitignored — never commit real keys.
#
# These six vars are the whole backend config. ISSUE-0.md copies this file into
# apps/api/.env once the templates are scaffolded; ISSUE-2.md deploys the same six
# to Cloud Run. After ISSUE-0, apps/api/.env is the file to edit.

# https://openrouter.ai/keys — one key, any model
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any slug from https://openrouter.ai/models, copied exactly. A wrong slug fails
# at request time, not at startup.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# LangSmith tracing. Key from https://smith.langchain.com -> Settings -> API keys.
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=langgraph-chat
