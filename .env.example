# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Backend (apps/api) ---

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI-compatible base URL — LangGraph talks to OpenRouter through this
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Any slug from https://openrouter.ai/models
# Cheap and fast for a tutorial. Alternatives: anthropic/claude-sonnet-5,
# google/gemini-3.7-flash, openai/gpt-5.6-sol
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Cloud Run injects PORT in production; used only for local runs
PORT=8000