# Copy to apps/api/.env and fill in. Gitignored — never commit real keys.
# This one file feeds the local backend AND the Cloud Run deploy (all six vars).

# https://openrouter.ai/keys — one key, any model
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any slug from https://openrouter.ai/models, copied exactly. A wrong slug
# fails at request time, not at startup.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# LangSmith tracing. Key from https://smith.langchain.com -> Settings -> API keys.
# Leave the key out and the graph still runs — you just get no traces.
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=langgraph-chat
