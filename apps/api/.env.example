# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Tracing. Both must be set for runs to appear in LangSmith, locally and on
# Cloud Run. Key from https://smith.langchain.com -> Settings -> API keys.
# US-region key: the eu.api.smith.langchain.com host rejects it with 403.
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=lsv2_pt_...

# Add API keys for connecting to LLM providers, data sources, and other integrations here
